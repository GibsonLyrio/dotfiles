{
    // ------------------------------------------------------------------------
    // Positioning settings
    // ------------------------------------------------------------------------

    // Waybar position
    //
    "position": "top",
    "layer": "top",
    "spacing": 8,
    "height": 50,
    "margin-top": 14,
    "margin-bottom": 0,
    "margin-left": 20,
    "margin-right": 10,


    // ------------------------------------------------------------------------
    // Modules settings
    // ------------------------------------------------------------------------

    // Load modules
    //
    "include": ["$HOME/.config/waybar/modules.json"],

    // Left modules
    //
    "modules-left": [
        "hyprland/window"
    ],

    // Center modules
    //
    "modules-center": [
        "hyprland/workspaces"
    ],

    // Right modules
    //
    "modules-right": [
        "group/hardware",
        "pulseaudio",
        "clock"
    ],

    // ------------------------------------------------------------------------
    // Modules group settings
    // ------------------------------------------------------------------------

    // Group hardware
    //
    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory",
            "disk"
        ]
    }
}

